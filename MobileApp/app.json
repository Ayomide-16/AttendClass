{
  "expo": {
    "name": "AttendClass",
    "slug": "attendclass-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ayomide16.attendclass"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothAlwaysPermission": "Allow AttendClass to use Bluetooth to check in at classroom devices."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AttendClass to access your camera to scan classroom QR codes."
        }
      ]
    ],
    "scheme": "attendclass"
  }
}
